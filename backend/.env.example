# === PostgreSQL (async, asyncpg) ===
# В Docker compose подменяется на @db:5432. Миграции: make migrate (как в docwise).
DATABASE_URL=postgresql+asyncpg://prompt_dj:prompt_dj@db:5432/prompt_dj

# === Redis (этап retrieval) ===
REDIS_URL=redis://localhost:6379/0

# === Безопасность ===
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# === OpenAI / KodikRouter ===
# KodikRouter (https://kodikrouter.ru/docs/base): OpenAI-compatible, base_url + Bearer key.
# Ключ sk-kr_* / kdk_* / sk-sr_* сам выбирает шлюз; модель с префиксом провайдера.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.kodikrouter.ru/v1
OPENAI_MODEL=openai/gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# === Embeddings ===
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# e5-small (~400 МБ) вместо e5-base (~1.1 ГБ) — меньше образ, чуть хуже качество
# Пусто локально; в Docker: /opt/models (HF_HUB_OFFLINE=1)
EMBEDDING_MODEL_PATH=

# === Pipeline ===
MAX_CANDIDATES=300
# 0 = embed весь пул кандидатов (рекомендуется)
SCORING_EMBED_LIMIT=0
EMBEDDING_BATCH_SIZE=64
PLAYLIST_SIZE=25
MAX_TRACKS_PER_ARTIST=2
PIPELINE_TIMEOUT_SEC=12

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_HOURS=720

# === Корпоративный прокси (как в docwise; нужен для oauth.yandex.ru с dev-server) ===
# HTTPS_PROXY=http://130.100.7.223:5000
# HTTP_PROXY=http://130.100.7.223:5000
# NO_PROXY=localhost,127.0.0.1,db,postgres,redis
